<Configuration>
	<appenders>
		<Console name = "Console">
			<PatternLayout pattern = "%d [%t] %5p %c::%M-%L - %m%n"/>
		</Console>
		
		<File name = "FileLogger" fileName = "logs/application.log">
			<PatternLayout pattern = "%d [%t] %5p %c::%M-%L - %m%n"/>
		</File>
	
	</appenders>

	<loggers>
		<root level="INFO">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="FileLogger"/>
		</root>
	
	</loggers>

</Configuration>